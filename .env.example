# ==============================================================================
# SALARIZE V2 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.production on your Windows Server VM
# and populate with secure, environment-specific values.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Production (PostgreSQL 16+ on Windows Server):
DATABASE_URL="postgresql://salarize_user:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/salarizedb?schema=public"

# For Local Development (SQLite):
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & SECRETS
# ------------------------------------------------------------------------------
# Generate a strong 256-bit random key: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET_KEY"

# Node Environment
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# 3. SMTP EMAIL NOTIFICATIONS & 2FA / OTP
# ------------------------------------------------------------------------------
# Brevo / Gmail / Corporate SMTP configuration:
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="your-smtp-user@yourdomain.com"
BREVO_SMTP_PASS="your-smtp-password-or-app-key"
EMAIL_FROM="\"Salarize HR System\" <no-reply@yourdomain.com>"

# ------------------------------------------------------------------------------
# 4. INITIAL GENESIS SUPER ADMIN (ONLY USED ON FIRST BOOT IF DB IS EMPTY)
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_USER="admin"
DEFAULT_ADMIN_EMAIL="admin@yourdomain.com"
DEFAULT_ADMIN_PASS="ChangeMeNow!2026"
