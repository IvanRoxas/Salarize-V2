        <mxCell id="db_daily_backup" value="&lt;b&gt;Daily Fresh Copy&lt;/b&gt;&lt;br&gt;&lt;font color='#2D6A4F'&gt;Automatically saves a fresh backup copy of the data every day&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D7C54;strokeWidth=1.2;fontSize=11;fontColor=#14532D;" vertex="1" parent="1">
