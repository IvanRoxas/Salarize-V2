        <mxCell id="app_auth" value="&lt;b&gt;Secure Logins and Identity&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;Handles secure logins, passwords, and two-factor code verification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D7C54;strokeWidth=1.2;fontSize=11;fontColor=#115E59;" vertex="1" parent="1">
