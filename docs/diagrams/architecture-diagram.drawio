        <mxCell id="db_vault" value="&lt;b&gt;Secure Digital Vault&lt;/b&gt;&lt;br&gt;&lt;font color='#8C5E3C'&gt;Safely houses all enterprise data and business records&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C26D38;strokeWidth=1.5;fontSize=11.5;fontColor=#6E2800;" vertex="1" parent="1">
